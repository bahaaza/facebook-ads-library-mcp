# scripts/setup.sh generates passwords; do not commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
POSTGRES_PASSWORD=replace-with-another-long-random-password
PUBLIC_URL=http://localhost:18473
PORT=18473
SCAN_GAP_SECONDS=30
POLL_SECONDS=5

# Optional email delivery. Requires an SMTP provider account, not a Facebook account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=starttls

# Optional Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
